#!/usr/bin/perl -w

use FindBin;
use lib "$FindBin::Bin/../../../perl_lib";
use EPrints;
use Pod::Usage;

use strict;
use warnings;


=pod

=head1 NAME

B<upgrade_exceptions_2029> - Find EPrint records which need their exceptions mapping over to new values, and maps them.

=head1 SYNOPSIS

B<upgrade_exceptions_2029> I<repository_id> I<eprint_id> 

=head1 DESCRIPTION

This script looks for any 2026 onward EPrint REF records which contain old values for REF CC exceptions and then maps them 
to the new ref2026 dataobj, recommitting them.


This script should be called upon updating your REF CC plugin to ref2029.

=head1 ARGUMENTS

=over 8

=item B<repository_id> 

The ID of the EPrint repository to use.

=back

=item B<eprint_id> 

Target a specific EPrint.

=back

=over 8
=back   
=cut


# The map of which fields should map to what.
my $ref_fields_map = {
    hoa_ex_dep => {
        b => ["ref2029_ex_dep", "c"],
        d => ["ref2029_ex_dep", "a"],
    },
    hoa_ex_acc => {
        a => ["ref2029_ex_acc", "b"],
        b => ["ref2029_ex_acc", "a"],        

        c => ["ref2029_ex_dep", "b"], # Goes to hoa_ex_dep
    },

    hoa_ex_fur => {
        a => ["ref2029_ex_fur", "TRUE"],
    }
};

my $repositoryid = $ARGV[0];
my $eprintid = $ARGV[1];


my $ep = EPrints->new();
my $repo = $ep->repository($repositoryid);
unless($repo) {die("could not find repository with id: $repositoryid");}


#get a dataset of eprints
my $ds = $repo->get_dataset("eprint");

my $search = $ds->prepare_search();

if(defined $eprintid){
    $search->add_field($ds->field("eprintid"), $eprintid);
}else{
    my $types = join( ' ', @{$repo->config( "hefce_oa", "item_types" )} );
    my $type_field = $ds->field( "type" );
    $search->add_field( fields => $type_field,
        value => $types, 
        match => 'EQ', 
        merge => 'ANY',
    );

    # this upgrade should only include items published after the rule change in Jan 26
    my $pub_field = $ds->field( "hoa_date_pub" );
	$search->add_field( fields => $pub_field,
		value => '2026-01-01-',
		match => 'IN',
	);


};


my $search_result = $search->perform_search();

print "This will update " . $search_result->count() . " records. Press Y to confirm\n";
if (uc <STDIN> ne "Y\n") {
    print "Exiting then.\n";
    exit();
}

# Don't set fields if there's stuff already there
sub set_without_clobber {
    my ($dataobj, $field, $value) = @_;
    if (defined $value) {
        if (!defined $dataobj->get_value($field)) {
            $dataobj->set_value($field, $value);
            return 1;
        }
    }
    return 0;
}

$search_result->map(sub{
        my($session, $dataset, $eprint) = @_;

        my $eprintid = $eprint->get_value("eprintid");
        my $ref2029_cc = $eprint->value("ref2029_cc");        

        # Set if a change has been made to the ref2029_cc record
        my $recommit_flag = 0;

        $recommit_flag = set_without_clobber($ref2029_cc, "ref2029_ex_dep_txt", $eprint->get_value("hoa_ex_dep_txt")) || $recommit_flag;
        $recommit_flag = set_without_clobber($ref2029_cc, "ref2029_ex_acc_txt", $eprint->get_value("hoa_ex_acc_txt")) || $recommit_flag;
        $recommit_flag = set_without_clobber($ref2029_cc, "ref2029_ex_tec_txt", $eprint->get_value("hoa_ex_tec_txt")) || $recommit_flag;
        $recommit_flag = set_without_clobber($ref2029_cc, "ref2029_ex_fur_txt", $eprint->get_value("hoa_ex_fur_txt")) || $recommit_flag;

        foreach my $old_field (keys %{$ref_fields_map}) {
            my $old_value = $eprint->get_value($old_field);

            if (defined $old_value) {
                my $new = $ref_fields_map->{$old_field}->{$old_value};
                if (defined $new) {
                    my ($new_field, $new_value) = @{$new};

                    if (set_without_clobber($ref2029_cc, $new_field, $new_value)) {
                        $recommit_flag = 1;
   
                        print "EPrint ${eprintid}: Mapping value '${old_value}' from field '${old_field}' to '${new_value}' in field '${new_field}'\n";
                    } else {
                        print "EPrint ${eprintid}: Did not map field '${old_field}' to '${new_field}', as '${new_field}' already contains a value\n";
                    };
                };
            }
        }

        if ($recommit_flag) {
            $ref2029_cc->{non_volatile_change} = 0;
            $ref2029_cc->commit();
        }
});

